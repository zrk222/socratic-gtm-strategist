    },
    {
      "category": "failure_recovery",
      "applicable": true,
      "reason": "Injected API 500, bad JSON, failed recon, voice provider error and preserved draft/state are covered."
    },
    {
      "category": "state_consistency",
      "applicable": true,
      "reason": "API context, answer edits, save/reload, session roundtrip, device copy removal and export values are covered."
    },
    {
      "category": "security_privacy",
      "applicable": true,
      "reason": "Private HTTP routes, origin/Host rejection, HTML/script injection and voice credential exclusion are covered."
    },
    {
      "category": "performance",
      "applicable": true,
      "reason": "Only declared request/response resource ceilings and bounded parsing are assessed; no load/latency benchmark claim."
    },
    {
      "category": "accessibility",
      "applicable": true,
      "reason": "Named controls, keyboard review, reduced motion and desktop/mobile layout are covered; assistive technology audit is outside scope."
    },
    {
      "category": "external_effects",
      "applicable": true,
      "reason": "Local downloads, mocked provider forwarding/errors, no real provider credentials and explicit evidence state are covered."
    }
